[Unit]
Description=BibiTasks controlled pilot
Wants=network-online.target
After=network-online.target docker.service remote-fs.target
Requires=docker.service
RequiresMountsFor=/mnt/bibitasks-backups
ConditionPathExists=/mnt/bibitasks-backups/.bibitasks-offhost

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/bibitasks
ExecStartPre=/usr/bin/test -f /mnt/bibitasks-backups/.bibitasks-offhost
ExecStart=/usr/bin/docker compose --env-file /etc/bibitasks/deploy.env -f compose.pilot.yaml up -d
ExecStop=/usr/bin/docker compose --env-file /etc/bibitasks/deploy.env -f compose.pilot.yaml stop
TimeoutStartSec=180
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
