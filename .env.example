# Telegram
# Обязательно заполните локально в .env. Никогда не коммитьте настоящий token.
BOT_TOKEN=
BOT_USERNAME=BbGalterbot
WEBAPP_SHORTNAME=bibibike
# Точный HTTPS URL, который открывает default menu button бота.
MINI_APP_URL=
# Production preflight требует также Main Mini App, настроенный в BotFather.
PREFLIGHT_REQUIRE_MAIN_MINI_APP=true
# Read-only release preflight checks that public Telegram branding matches.
PREFLIGHT_EXPECTED_BOT_NAME=БибиЗадачи · Бибибайк
PREFLIGHT_EXPECTED_GROUP_TITLE=Бибибайк | Сообщество помощников
PREFLIGHT_EXPECTED_GROUP_DESCRIPTION=Помогаем Бибибайку в своём городе и получаем бибибонусы на поездки. Задания: @BbGalterbot → «Открыть задания». 1 бонус = 1 ₽, минута — 8,5 ₽.
BOT_PROFILE_DESCRIPTION=Выполняйте задания Бибибайка в своём городе, прикладывайте фото результата и получайте бибибонусы на поездки. 1 бибибонус заменяет 1 ₽, минута стоит 8,5 ₽.
BOT_PROFILE_SHORT_DESCRIPTION=Задания Бибибайка: помогайте городу и получайте бибибонусы на поездки.
BOT_MENU_TEXT=Открыть задания
REQUIRED_CHAT=@bbbikefan
REQUIRED_CHAT_URL=https://t.me/bbbikefan
# Необязательно: публичная политика обработки данных. Только HTTPS, без логина/пароля.
# Если строка пуста, Mini App показывает короткое уведомление без выдуманной ссылки.
PRIVACY_URL=
GROUP_USERNAME=bbbikefan
# В production обязателен числовой ID публичной группы вида -100..., чтобы
# приложение гарантированно отличило её от private OPS.
GROUP_ID=
COMMUNITY_CHAT_ID=0
TOPIC_NEWS=
TOPIC_CHAT=
TOPIC_WORK=
TOPIC_FRANCHISE=
# Отдельная приватная supergroup для рабочих адресов и фотографий.
# Не указывайте здесь публичную группу/канал.
OPS_GROUP_ID=
OPS_GROUP_USERNAME=
OPS_TOPIC_TASKS=

# Доступ и web
BIBITASKS_ENVIRONMENT=production
# Telegram user IDs минимум двух ответственных через запятую; храните как secret.
ADMIN_IDS=
# Скользящий лимит за 24 часа одновременно на ответственного и получателя.
# Быстрая благодарность только положительная; рекомендуемое значение для пилота.
MANUAL_GRANT_DAILY_LIMIT=300
PORT=3000
DATA_DIR=/app/data
INIT_DATA_MAX_AGE_SEC=900
PHOTO_URL_TTL_SEC=900
# Отдельная подпись короткоживущих URL фотографий, не BOT_TOKEN.
MEDIA_SIGNING_KEY=
# local для одного экземпляра; s3 — для нескольких replicas/managed storage.
MEDIA_STORAGE=local
S3_BUCKET=
S3_PREFIX=bibitasks
S3_REGION=us-east-1
# Для AWS оставьте endpoint пустым; для S3-compatible укажите внутренний HTTPS URL.
S3_ENDPOINT_URL=
# Публичный HTTPS endpoint нужен только если он отличается от внутреннего.
S3_PUBLIC_ENDPOINT_URL=
S3_ADDRESSING_STYLE=auto
S3_SSE=AES256
# AWS и провайдеры с поддержкой Public Access Block: оставьте default.
# Если compatible storage не поддерживает этот API, выберите operator_attested
# только после отдельной проверки bucket policy/ACL и подтвердите ниже.
S3_PRIVACY_MODE=public_access_block
S3_PRIVATE_BUCKET_CONFIRMED=false
API_READS_PER_MIN=120
API_WRITES_PER_MIN=40
# Отдельный случайный секрет для HMAC обезличенной аналитики (минимум 32 байта).
ANALYTICS_SECRET=
# Локально оставьте polling. В production используйте webhook.
TELEGRAM_UPDATE_MODE=polling
# Только staging/test может ускорять повторы для приёмки. В production любые
# значения, отличные от 2/3600/10, останавливают запуск fail-closed.
TELEGRAM_RETRY_BASE_SECONDS=2
TELEGRAM_RETRY_MAX_SECONDS=3600
TELEGRAM_RETRY_MAX_ATTEMPTS=10
# Обязательны только для webhook. URL — HTTPS origin без пути.
PUBLIC_BASE_URL=
# Четыре разные случайные строки; не используйте здесь BOT_TOKEN.
# python -c "import secrets; [print(secrets.token_urlsafe(32)) for _ in range(4)]"
WEBHOOK_ROUTE_ID=
WEBHOOK_SECRET=
HEALTH_TOKEN=
WEBHOOK_MAX_CONNECTIONS=8
# Ключ шифрования входящих updates. Создать так же, как WITHDRAW_ACCOUNT_KEY ниже.
TELEGRAM_INBOX_KEY=
# Compose публикует API только на loopback. Внешний HTTPS завершает reverse proxy.
HOST_BIND=127.0.0.1
HOST_PORT=3000

# Только для offline migration harness. main.py этот DSN не читает и PostgreSQL
# runtime пока не поддерживает.
MIGRATION_DATABASE_URL=

# Экономика
RIDE_RUB_PER_MIN=8.5
WITHDRAW_MIN=1000
WITHDRAW_PROCESSING_LEASE_MIN=30
WITHDRAW_CONTACT=KiriLegenda
# Сгенерируйте один раз: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Без этого ключа новые заявки на перевод безопасно отклоняются.
WITHDRAW_ACCOUNT_KEY=
# После завершения заявки полный зашифрованный ID удаляется через этот срок.
WITHDRAW_ACCOUNT_RETENTION_DAYS=90
